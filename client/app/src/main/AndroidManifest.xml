<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Discovery is a UDP broadcast; both of these are needed to send one and to
         see which network we are on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation. Also requested at runtime; without the runtime grant the
         recorder returns no samples rather than failing loudly. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- No VR features on purpose: declaring them is what makes Horizon OS take
         the headset. A plain 2D app gets a window, and windows multitask. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="linux terminal"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- The front door: which machine to work on. -->
        <activity
            android:name=".ServersActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <layout
                android:defaultWidth="900dp"
                android:defaultHeight="700dp"
                android:minWidth="480dp"
                android:minHeight="400dp"
                android:gravity="center" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- documentLaunchMode="always" gives every launch its own task, so several
             terminals — on several machines — can be open side by side. -->
        <activity
            android:name=".TermActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <!-- The shell renders roughly 1.25 px per dp here, so 1600dp is about
                 2000 px across: at the default 20 px cell that is ~110 columns,
                 which is what a terminal wants. -->
            <layout
                android:defaultWidth="1600dp"
                android:defaultHeight="1000dp"
                android:minWidth="480dp"
                android:minHeight="360dp"
                android:gravity="center" />
        </activity>

        <!-- The bar in a window of its own, so the shell sizes it independently.
             Its buttons wrap, so a wider or taller window shows more of them —
             which a strip pinned to the terminal's width could never do. -->
        <activity
            android:name=".BarActivity"
            android:exported="false"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:taskAffinity="dev.butschster.linuxterminal.bar"
            android:label="terminal bar"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <layout
                android:defaultWidth="1150dp"
                android:defaultHeight="460dp"
                android:minWidth="700dp"
                android:minHeight="320dp"
                android:gravity="bottom" />
        </activity>
    </application>

</manifest>
